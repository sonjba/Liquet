# Copy this file to .env and fill in what you need. .env is never committed.
# Empty means not set: Liquet uses its default.

# Your Anthropic API key. Only needed to ask Claude for real (investigate, whole_loop --live).
ANTHROPIC_API_KEY=

# The folder that holds every run. Default: runs
LIQUET_RUNS_DIR=

# The Claude model investigate asks. Default: claude-sonnet-5-5
LIQUET_MODEL=